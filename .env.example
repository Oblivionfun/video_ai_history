# Copy to .env and fill in what you use. .env is git-ignored.

# 火山引擎 · 豆包语音合成 2.0 / 声音复刻 2.0（推荐的中文旁白）
# 新版控制台只需要 API Key；旧版控制台用 APP ID + Access Token。
VOLC_API_KEY=
VOLC_APP_ID=
VOLC_ACCESS_TOKEN=

# 微软 Azure Speech（官方渠道：云健 + documentary-narration 风格 + 拼音标注）
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# MiniMax（备选：读字准确度高）
MINIMAX_API_KEY=

# ElevenLabs（英文版 YouTube 频道）
ELEVENLABS_API_KEY=
