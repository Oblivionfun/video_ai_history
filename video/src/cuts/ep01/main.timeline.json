   "start": 196.243,
   "end": 198.039,
   "segs": [
    {
     "text": "七天后走出雪山",
     "q": false
    }
   ]
  },
  {
   "line": "c5a",
   "start": 198.039,
   "end": 200.668,
   "segs": [
    {
     "text": "同行的人",
     "q": false
    },
    {
     "text": "“馁冻死者十有三四”",
     "q": true
    }
   ]
  },
  {
   "line": "c5b",
   "start": 201.118,
   "end": 205.689,
   "segs": [
    {
     "text": "在素叶城  西突厥可汗设宴款待  派人护送",
     "q": false
    }
   ]
  },
  {
   "line": "c5b",
   "start": 205.689,
   "end": 207.559,
   "segs": [
    {
     "text": "又修书给沿途诸国",
     "q": false
    }
   ]
  },
  {
   "line": "c5c",
   "start": 208.009,
   "end": 210.166,
   "segs": [
    {
     "text": "国书一封接着一封",
     "q": false
    }
   ]
  },
  {
   "line": "c5c",
   "start": 210.166,
   "end": 211.376,
   "segs": [
    {
     "text": "到了小说里",
     "q": false
    }
   ]
  },
  {
   "line": "c5c",
   "start": 211.376,
   "end": 215.756,
   "segs": [
    {
     "text": "它们变成了每到一国都要盖上宝印的",
     "q": false
    },
    {
     "text": "“通关文牒”",
     "q": true
    }
   ]
  },
  {
   "line": "c6a",
   "start": 220.356,
   "end": 223.196,
   "segs": [
    {
     "text": "他穿过撒马尔罕  走过铁门",
     "q": false
    }
   ]
  },
  {
   "line": "c6a",
   "start": 223.196,
   "end": 225.939,
   "segs": [
    {
     "text": "翻越终年积雪的兴都库什山",
     "q": false
    }
   ]
  },
  {
   "line": "c6b",
   "start": 226.389,
   "end": 229.757,
   "segs": [
    {
     "text": "在梵衍那  他见到高达百余尺的立佛",
     "q": false
    }
   ]
  },
  {
   "line": "c6b",
   "start": 229.757,
   "end": 232.183,
   "segs": [
    {
     "text": "“金色晃曜  宝饰焕烂”",
     "q": true
    }
   ]
  },
  {
   "line": "c6c",
   "start": 232.633,
   "end": 236.144,
   "segs": [
    {
     "text": "一千三百多年后  大佛被炸毁",
     "q": false
    }
   ]
  },
  {
   "line": "c6c",
   "start": 236.144,
   "end": 240.258,
   "segs": [
    {
     "text": "玄奘的记录  成了它们最珍贵的见证之一",
     "q": false
    }
   ]
  },
  {
   "line": "c7a",
   "start": 244.658,
   "end": 246.877,
   "segs": [
    {
     "text": "进入天竺  在恒河之上",
     "q": false
    }
   ]
  },
  {
   "line": "c7a",
   "start": 246.877,
   "end": 250.697,
   "segs": [
    {
     "text": "他遭遇了一伙信奉突伽天神的强盗",
     "q": false
    }
   ]
  },
  {
   "line": "c7a",
   "start": 250.697,
   "end": 254.128,
   "segs": [
    {
     "text": "他们要找一个",
     "q": false
    },
    {
     "text": "“质状端美”",
     "q": true
    },
    {
     "text": "的人  杀了祭神",
     "q": false
    }
   ]
  },
  {
   "line": "c7b",
   "start": 254.578,
   "end": 256.765,
   "segs": [
    {
     "text": "选中的  正是玄奘",
     "q": false
    }
   ]
  },
  {
   "line": "c7c",
   "start": 257.215,
   "end": 258.93,
   "segs": [
    {
     "text": "他闭目观想",
     "q": false
    }
   ]
  },
  {
   "line": "c7c",
   "start": 258.93,
   "end": 263.266,
   "segs": [
    {
     "text": "忽然间  ",
     "q": false
    },
    {
     "text": "“黑风四起  折树飞沙  河流涌浪”",
     "q": true
    }
   ]
  },
  {
   "line": "c7c",
   "start": 263.266,
   "end": 266.071,
   "segs": [
    {
     "text": "强盗们大惊失色  跪地忏悔",
     "q": false
    }
   ]
  },
  {
   "line": "c7d",
   "start": 266.521,
   "end": 270.399,
   "segs": [
    {
     "text": "小说里  几乎每个妖怪都想吃唐僧肉",
     "q": false
    }
   ]
  },
  {
   "line": "c7d",
   "start": 270.399,
   "end": 274.265,
   "segs": [
    {
     "text": "这个再熟悉不过的情节  在历史上早有原型",
     "q": false
    }
   ]
  },
  {
   "line": "c8a",
   "start": 278.265,
   "end": 280.452,
   "segs": [
    {
     "text": "终于  他来到那烂陀寺",
     "q": false
    }
   ]
  },
  {
   "line": "c8a",
   "start": 280.452,
   "end": 285.603,
   "segs": [
    {
     "text": "当时天竺最高的佛教学府  ",
     "q": false
    },
    {
     "text": "“僧徒主客  常有万人”",
     "q": true
    }
   ]
  },
  {
   "line": "c8b",
   "start": 286.053,
   "end": 290.222,
   "segs": [
    {
     "text": "戒贤法师亲自为他讲授《瑜伽师地论》",
     "q": false
    }
   ]
  },
  {
   "line": "c8b",
   "start": 290.222,
   "end": 292.817,
   "segs": [
    {
     "text": "他在这里  一学就是五年",
     "q": false
    }
   ]
  },
  {
   "line": "c8c",
   "start": 293.867,
   "end": 297.088,
   "segs": [
    {
     "text": "不远处的王舍城外  有一座灵鹫山",
     "q": false
    }
   ]
  },
  {
   "line": "c8c",
   "start": 297.088,
   "end": 299.724,
   "segs": [
    {
     "text": "相传佛陀曾在此说法",
     "q": false
    }
   ]
  },
  {
   "line": "c8c",
   "start": 299.724,
   "end": 303.873,
   "segs": [
    {
     "text": "小说里师徒四人历尽艰辛才抵达的灵山",
     "q": false
    }
   ]
  },
  {
   "line": "c8c",
   "start": 303.873,
   "end": 305.337,
   "segs": [
    {
     "text": "名字正由此而来",
     "q": false
    }
   ]
  },
  {
   "line": "c9a",
   "start": 307.937,
   "end": 310.442,
   "segs": [
    {
     "text": "此后数年  他遍游五印度",
     "q": false
    }
   ]
  },
  {
   "line": "c9a",
   "start": 310.442,
   "end": 314.91,
   "segs": [
    {
     "text": "东到海滨  南抵建志补罗  西至信度河畔",
     "q": false
    }
   ]
  },
  {
   "line": "c9a",
   "start": 314.91,
   "end": 317.001,
   "segs": [
    {
     "text": "遍访名师  寻礼圣迹",
     "q": false
    }
   ]
  },
  {
   "line": "c10a",
   "start": 321.201,
   "end": 325.288,
   "segs": [
    {
     "text": "公元六四二年  戒日王在曲女城召开大会",
     "q": false
    }
   ]
  },
  {
   "line": "c10a",
   "start": 325.288,
   "end": 329.059,
   "segs": [
    {
     "text": "十八国国王  数千名僧侣与婆罗门云集",
     "q": false
    }
   ]
  },
  {
   "line": "c10b",
   "start": 329.509,
   "end": 332.921,
   "segs": [
    {
     "text": "玄奘作为论主  把论文悬于会场门外",
     "q": false
    }
   ]
  },
  {
   "line": "c10b",
   "start": 332.921,
   "end": 337.269,
   "segs": [
    {
     "text": "“若其间有一字无理能难破者  请斩首相谢”",
     "q": true
    }
   ]
  },
  {
   "line": "c10c",
   "start": 337.719,
   "end": 341.064,
   "segs": [
    {
     "text": "整整十八天  无人能驳倒他",
     "q": false
    }
   ]
  },
  {
   "line": "c10c",
   "start": 341.064,
   "end": 342.702,
   "segs": [
    {
     "text": "他被尊为",
     "q": false
    },
    {
     "text": "“大乘天”",
     "q": true
    }
   ]
  },
  {
   "line": "c10d",
   "start": 343.152,
   "end": 347.535,
   "segs": [
    {
     "text": "小说里  车迟国斗法  砍头  剖腹  下油锅",
     "q": false
    }
   ]
  },
  {
   "line": "c10d",
   "start": 347.535,
   "end": 349.29,
   "segs": [
    {
     "text": "孙悟空样样不怕",
     "q": false
    }
   ]
  },
  {
   "line": "c10d",
   "start": 349.29,
   "end": 351.536,
   "segs": [
    {
     "text": "仿佛正是这场论战的回响",
     "q": false
    }
   ]
  },
  {
   "line": "c11a",
   "start": 355.536,
   "end": 359.959,
   "segs": [
    {
     "text": "六四三年  他谢绝了戒日王的挽留  踏上归途",
     "q": false
    }
   ]
  },
  {
   "line": "c11b",
   "start": 360.409,
   "end": 364.017,
   "segs": [
    {
     "text": "渡信度河时  船到中流  风浪骤起",
     "q": false
    }
   ]
  },
  {
   "line": "c11b",
   "start": 364.017,
   "end": 368.037,
   "segs": [
    {
     "text": "五十夹经书和带回的花种  沉入了河中",
     "q": false
    }
   ]
  },
  {
   "line": "c11c",
   "start": 368.487,
   "end": 370.081,
   "segs": [
    {
     "text": "小说的最后一难",
     "q": false
    }
   ]
  },
  {
   "line": "c11c",
   "start": 370.081,
   "end": 374.27,
   "segs": [
    {
     "text": "通天河的老鼋把师徒掀入水中  经书湿透",
     "q": false
    }
   ]
  },
  {
   "line": "c11c",
   "start": 374.27,
   "end": 376.198,
   "segs": [
    {
     "text": "晾晒时又粘破了几页",
     "q": false
    }
   ]
  },
  {
   "line": "c11c",
   "start": 376.198,
   "end": 379.711,
   "segs": [
    {
     "text": "“经不全”",
     "q": true
    },
    {
     "text": "的遗憾  竟与历史如此相似",
     "q": false
    }
   ]
  },
  {
   "line": "c12a",
   "start": 383.711,
   "end": 387.798,
   "segs": [
    {
     "text": "他翻越帕米尔高原  古称葱岭  ",
     "q": false
    },
    {
     "text": "“寒风凄劲",
     "q": true
    }
   ]
  },
  {
   "line": "c12a",
   "start": 387.798,
   "end": 388.936,
   "segs": [
    {
     "text": "春夏飞雪”",
     "q": true
    }
   ]
  },
  {
   "line": "c12b",
   "start": 389.386,
   "end": 392.762,
   "segs": [
    {
     "text": "在于阗  他向唐太宗上表请罪",
     "q": false
    }
   ]
  },
  {
   "line": "c12b",
   "start": 392.762,
   "end": 397.749,
   "segs": [
    {
     "text": "太宗回信  ",
     "q": false
    },
    {
     "text": "“闻师访道殊域  今得归还  欢喜无量”",
     "q": true
    }
   ]
  },
  {
   "line": "c12c",
   "start": 398.199,
   "end": 400.881,
   "segs": [
    {
     "text": "他沿着塔克拉玛干的南缘东行",
     "q": false
    }
   ]
  },
  {
   "line": "c12c",
   "start": 400.881,
   "end": 405.792,
   "segs": [
    {
     "text": "穿过",
     "q": false
    },
    {
     "text": "“聚散随风  人行无迹”",
     "q": true
    },
    {
     "text": "的大流沙  回到敦煌",
     "q": false
    }
   ]
  },
  {
   "line": "c13a",
   "start": 410.192,
   "end": 413.483,
   "segs": [
    {
     "text": "贞观十九年  公元六四五年正月",
     "q": false
    }
   ]
  },
  {
   "line": "c13a",
   "start": 413.483,
   "end": 415.588,
   "segs": [
    {
     "text": "玄奘回到长安",
     "q": false
    }
   ]
  },
  {
   "line": "c13a",
   "start": 415.588,
   "end": 418.352,
   "segs": [
    {
     "text": "百姓夹道相迎  万人空巷",
     "q": false
    }
   ]
  },
  {
   "line": "c13b",
   "start": 418.802,
   "end": 421.764,
   "segs": [
    {
     "text": "他带回佛经六百五十七部",
     "q": false
    }
   ]
  },
  {
   "line": "c13b",
   "start": 421.764,
   "end": 426.032,
   "segs": [
    {
     "text": "此后十九年  译出经论一千三百三十五卷",
     "q": false
    }
   ]
  },
  {
   "line": "c13b",
   "start": 426.032,
   "end": 428.779,
   "segs": [
    {
     "text": "又口述写成《大唐西域记》",
     "q": false
    }
   ]
  },
  {
   "line": "c13c",
   "start": 429.229,
   "end": 432.519,
   "segs": [
    {
     "text": "此后  他的故事被一代代人讲述",
     "q": false
    }
   ]
  },
  {
   "line": "c13c",
   "start": 432.519,
   "end": 436.868,
   "segs": [
    {
     "text": "南宋的《大唐三藏取经诗话》里出现了猴行者",
     "q": false
    }
   ]
  },
  {
   "line": "c13c",
   "start": 436.868,
   "end": 439.845,
   "segs": [
    {
     "text": "到了明代  吴承恩写成了《西游记》",
     "q": false
    }
   ]
  },
  {
   "line": "e1",
   "start": 443.445,
   "end": 447.413,
   "segs": [
    {
     "text": "神话里  筋斗云一个跟头  十万八千里",
     "q": false
    }
   ]
  },
  {
   "line": "e2",
   "start": 448.363,
   "end": 452.891,
   "segs": [
    {
     "text": "历史上  只有一双脚  一步一步  走了五万里",
     "q": false
    }
   ]
  },
  {
   "line": "e2",
   "start": 452.891,
   "end": 454.056,
   "segs": [
    {
     "text": "走了十七年",
     "q": false
    }
   ]
  },
  {
   "line": "e3",
   "start": 455.306,
   "end": 458.617,
   "segs": [
    {
     "text": "从玄奘到唐僧  从一个人的西行",
     "q": false
    }
   ]
  },
  {
   "line": "e3",
   "start": 458.617,
   "end": 460.387,
   "segs": [
    {
     "text": "到一个民族的神话",
     "q": false
    }
   ]
  }
 ]
}