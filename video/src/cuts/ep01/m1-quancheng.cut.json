{
  "id": "m1-quancheng",
  "episode": "ep01",
  "title": "一张地图，走完玄奘西行全程",
  "formats": ["portrait"],
  "voice": {"provider": "edge", "voice": "zh-CN-YunjianNeural", "rate": "-3%"},
  "gap": 0.36,
