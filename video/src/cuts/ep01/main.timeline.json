   "line": "c5a",
   "start": 209.157,
   "end": 211.167,
   "segs": [
    {
     "text": "七天后走出雪山",
     "q": false
    }
   ]
  },
  {
   "line": "c5a",
   "start": 211.167,
   "end": 214.754,
   "segs": [
    {
     "text": "同行的人",
     "q": false
    },
    {
     "text": "“馁冻死者十有三四”",
     "q": true
    }
   ]
  },
  {
   "line": "c5b",
   "start": 215.213,
   "end": 220.433,
   "segs": [
    {
     "text": "在素叶城  西突厥可汗设宴款待  派人护送",
     "q": false
    }
   ]
  },
  {
   "line": "c5b",
   "start": 220.433,
   "end": 222.322,
   "segs": [
    {
     "text": "又修书给沿途诸国",
     "q": false
    }
   ]
  },
  {
   "line": "c5c",
   "start": 222.774,
   "end": 225.014,
   "segs": [
    {
     "text": "国书一封接着一封",
     "q": false
    }
   ]
  },
  {
   "line": "c5c",
   "start": 225.014,
   "end": 226.364,
   "segs": [
    {
     "text": "到了小说里",
     "q": false
    }
   ]
  },
  {
   "line": "c5c",
   "start": 226.364,
   "end": 230.846,
   "segs": [
    {
     "text": "它们变成了每到一国都要盖上宝印的",
     "q": false
    },
    {
     "text": "“通关文牒”",
     "q": true
    }
   ]
  },
  {
   "line": "c6a",
   "start": 235.446,
   "end": 238.863,
   "segs": [
    {
     "text": "他穿过撒马尔罕  走过铁门",
     "q": false
    }
   ]
  },
  {
   "line": "c6a",
   "start": 238.863,
   "end": 241.984,
   "segs": [
    {
     "text": "翻越终年积雪的兴都库什山",
     "q": false
    }
   ]
  },
  {
   "line": "c6b",
   "start": 242.452,
   "end": 246.064,
   "segs": [
    {
     "text": "在梵衍那  他见到高达百余尺的立佛",
     "q": false
    }
   ]
  },
  {
   "line": "c6b",
   "start": 246.064,
   "end": 248.691,
   "segs": [
    {
     "text": "“金色晃曜  宝饰焕烂”",
     "q": true
    }
   ]
  },
  {
   "line": "c6c",
   "start": 249.176,
   "end": 252.206,
   "segs": [
    {
     "text": "一千三百多年后  大佛被炸毁",
     "q": false
    }
   ]
  },
  {
   "line": "c6c",
   "start": 252.206,
   "end": 255.927,
   "segs": [
    {
     "text": "玄奘的记录  成了它们最珍贵的见证之一",
     "q": false
    }
   ]
  },
  {
   "line": "c7a",
   "start": 260.332,
   "end": 263.212,
   "segs": [
    {
     "text": "进入天竺  在恒河之上",
     "q": false
    }
   ]
  },
  {
   "line": "c7a",
   "start": 263.212,
   "end": 266.962,
   "segs": [
    {
     "text": "他遭遇了一伙信奉突伽天神的强盗",
     "q": false
    }
   ]
  },
  {
   "line": "c7a",
   "start": 266.962,
   "end": 271.051,
   "segs": [
    {
     "text": "他们要找一个",
     "q": false
    },
    {
     "text": "“质状端美”",
     "q": true
    },
    {
     "text": "的人  杀了祭神",
     "q": false
    }
   ]
  },
  {
   "line": "c7b",
   "start": 271.51,
   "end": 273.721,
   "segs": [
    {
     "text": "选中的  正是玄奘",
     "q": false
    }
   ]
  },
  {
   "line": "c7c",
   "start": 274.172,
   "end": 275.772,
   "segs": [
    {
     "text": "他闭目观想",
     "q": false
    }
   ]
  },
  {
   "line": "c7c",
   "start": 275.772,
   "end": 280.902,
   "segs": [
    {
     "text": "忽然间  ",
     "q": false
    },
    {
     "text": "“黑风四起  折树飞沙  河流涌浪”",
     "q": true
    }
   ]
  },
  {
   "line": "c7c",
   "start": 280.902,
   "end": 283.876,
   "segs": [
    {
     "text": "强盗们大惊失色  跪地忏悔",
     "q": false
    }
   ]
  },
  {
   "line": "c7d",
   "start": 284.334,
   "end": 288.414,
   "segs": [
    {
     "text": "小说里  几乎每个妖怪都想吃唐僧肉",
     "q": false
    }
   ]
  },
  {
   "line": "c7d",
   "start": 288.414,
   "end": 292.639,
   "segs": [
    {
     "text": "这个再熟悉不过的情节  在历史上早有原型",
     "q": false
    }
   ]
  },
  {
   "line": "c8a",
   "start": 296.644,
   "end": 299.574,
   "segs": [
    {
     "text": "终于  他来到那烂陀寺",
     "q": false
    }
   ]
  },
  {
   "line": "c8a",
   "start": 299.574,
   "end": 304.756,
   "segs": [
    {
     "text": "当时天竺最高的佛教学府  ",
     "q": false
    },
    {
     "text": "“僧徒主客  常有万人”",
     "q": true
    }
   ]
  },
  {
   "line": "c8b",
   "start": 305.212,
   "end": 309.282,
   "segs": [
    {
     "text": "戒贤法师亲自为他讲授《瑜伽师地论》",
     "q": false
    }
   ]
  },
  {
   "line": "c8b",
   "start": 309.282,
   "end": 311.913,
   "segs": [
    {
     "text": "他在这里  一学就是五年",
     "q": false
    }
   ]
  },
  {
   "line": "c8c",
   "start": 312.968,
   "end": 316.338,
   "segs": [
    {
     "text": "不远处的王舍城外  有一座灵鹫山",
     "q": false
    }
   ]
  },
  {
   "line": "c8c",
   "start": 316.338,
   "end": 318.938,
   "segs": [
    {
     "text": "相传佛陀曾在此说法",
     "q": false
    }
   ]
  },
  {
   "line": "c8c",
   "start": 318.938,
   "end": 323.168,
   "segs": [
    {
     "text": "小说里师徒四人历尽艰辛才抵达的灵山",
     "q": false
    }
   ]
  },
  {
   "line": "c8c",
   "start": 323.168,
   "end": 324.764,
   "segs": [
    {
     "text": "名字正由此而来",
     "q": false
    }
   ]
  },
  {
   "line": "c9a",
   "start": 327.377,
   "end": 330.357,
   "segs": [
    {
     "text": "此后数年  他遍游五印度",
     "q": false
    }
   ]
  },
  {
   "line": "c9a",
   "start": 330.357,
   "end": 335.117,
   "segs": [
    {
     "text": "东到海滨  南抵建志补罗  西至信度河畔",
     "q": false
    }
   ]
  },
  {
   "line": "c9a",
   "start": 335.117,
   "end": 337.714,
   "segs": [
    {
     "text": "遍访名师  寻礼圣迹",
     "q": false
    }
   ]
  },
  {
   "line": "c10a",
   "start": 341.914,
   "end": 346.271,
   "segs": [
    {
     "text": "公元六四二年  戒日王在曲女城召开大会",
     "q": false
    }
   ]
  },
  {
   "line": "c10a",
   "start": 346.271,
   "end": 350.396,
   "segs": [
    {
     "text": "十八国国王  数千名僧侣与婆罗门云集",
     "q": false
    }
   ]
  },
  {
   "line": "c10b",
   "start": 350.85,
   "end": 354.526,
   "segs": [
    {
     "text": "玄奘作为论主  把论文悬于会场门外",
     "q": false
    }
   ]
  },
  {
   "line": "c10b",
   "start": 354.526,
   "end": 359.118,
   "segs": [
    {
     "text": "“若其间有一字无理能难破者  请斩首相谢”",
     "q": true
    }
   ]
  },
  {
   "line": "c10c",
   "start": 359.568,
   "end": 362.728,
   "segs": [
    {
     "text": "整整十八天  无人能驳倒他",
     "q": false
    }
   ]
  },
  {
   "line": "c10c",
   "start": 362.728,
   "end": 364.728,
   "segs": [
    {
     "text": "他被尊为",
     "q": false
    },
    {
     "text": "“大乘天”",
     "q": true
    }
   ]
  },
  {
   "line": "c10d",
   "start": 365.18,
   "end": 370.69,
   "segs": [
    {
     "text": "小说里  车迟国斗法  砍头  剖腹  下油锅",
     "q": false
    }
   ]
  },
  {
   "line": "c10d",
   "start": 370.69,
   "end": 372.47,
   "segs": [
    {
     "text": "孙悟空样样不怕",
     "q": false
    }
   ]
  },
  {
   "line": "c10d",
   "start": 372.47,
   "end": 374.891,
   "segs": [
    {
     "text": "仿佛正是这场论战的回响",
     "q": false
    }
   ]
  },
  {
   "line": "c11a",
   "start": 378.922,
   "end": 383.705,
   "segs": [
    {
     "text": "六四三年  他谢绝了戒日王的挽留  踏上归途",
     "q": false
    }
   ]
  },
  {
   "line": "c11b",
   "start": 384.155,
   "end": 388.505,
   "segs": [
    {
     "text": "渡信度河时  船到中流  风浪骤起",
     "q": false
    }
   ]
  },
  {
   "line": "c11b",
   "start": 388.505,
   "end": 392.47,
   "segs": [
    {
     "text": "五十夹经书和带回的花种  沉入了河中",
     "q": false
    }
   ]
  },
  {
   "line": "c11c",
   "start": 392.92,
   "end": 394.532,
   "segs": [
    {
     "text": "小说的最后一难",
     "q": false
    }
   ]
  },
  {
   "line": "c11c",
   "start": 394.532,
   "end": 398.897,
   "segs": [
    {
     "text": "通天河的老鼋把师徒掀入水中  经书湿透",
     "q": false
    }
   ]
  },
  {
   "line": "c11c",
   "start": 398.897,
   "end": 401.0,
   "segs": [
    {
     "text": "晾晒时又粘破了几页",
     "q": false
    }
   ]
  },
  {
   "line": "c11c",
   "start": 401.0,
   "end": 404.518,
   "segs": [
    {
     "text": "“经不全”",
     "q": true
    },
    {
     "text": "的遗憾  竟与历史如此相似",
     "q": false
    }
   ]
  },
  {
   "line": "c12a",
   "start": 408.518,
   "end": 413.455,
   "segs": [
    {
     "text": "他翻越帕米尔高原  古称葱岭  ",
     "q": false
    },
    {
     "text": "“寒风凄劲",
     "q": true
    }
   ]
  },
  {
   "line": "c12a",
   "start": 413.455,
   "end": 414.662,
   "segs": [
    {
     "text": "春夏飞雪”",
     "q": true
    }
   ]
  },
  {
   "line": "c12b",
   "start": 415.124,
   "end": 418.824,
   "segs": [
    {
     "text": "在于阗  他向唐太宗上表请罪",
     "q": false
    }
   ]
  },
  {
   "line": "c12b",
   "start": 418.824,
   "end": 424.329,
   "segs": [
    {
     "text": "太宗回信  ",
     "q": false
    },
    {
     "text": "“闻师访道殊域  今得归还  欢喜无量”",
     "q": true
    }
   ]
  },
  {
   "line": "c12c",
   "start": 424.791,
   "end": 427.611,
   "segs": [
    {
     "text": "他沿着塔克拉玛干的南缘东行",
     "q": false
    }
   ]
  },
  {
   "line": "c12c",
   "start": 427.611,
   "end": 432.97,
   "segs": [
    {
     "text": "穿过",
     "q": false
    },
    {
     "text": "“聚散随风  人行无迹”",
     "q": true
    },
    {
     "text": "的大流沙  回到敦煌",
     "q": false
    }
   ]
  },
  {
   "line": "c13a",
   "start": 437.38,
   "end": 440.8,
   "segs": [
    {
     "text": "贞观十九年  公元六四五年正月",
     "q": false
    }
   ]
  },
  {
   "line": "c13a",
   "start": 440.8,
   "end": 442.591,
   "segs": [
    {
     "text": "玄奘回到长安",
     "q": false
    }
   ]
  },
  {
   "line": "c13a",
   "start": 442.591,
   "end": 445.594,
   "segs": [
    {
     "text": "百姓夹道相迎  万人空巷",
     "q": false
    }
   ]
  },
  {
   "line": "c13b",
   "start": 446.056,
   "end": 448.736,
   "segs": [
    {
     "text": "他带回佛经六百五十七部",
     "q": false
    }
   ]
  },
  {
   "line": "c13b",
   "start": 448.736,
   "end": 453.056,
   "segs": [
    {
     "text": "此后十九年  译出经论一千三百三十五卷",
     "q": false
    }
   ]
  },
  {
   "line": "c13b",
   "start": 453.056,
   "end": 455.75,
   "segs": [
    {
     "text": "又口述写成《大唐西域记》",
     "q": false
    }
   ]
  },
  {
   "line": "c13c",
   "start": 456.25,
   "end": 459.591,
   "segs": [
    {
     "text": "此后  他的故事被一代代人讲述",
     "q": false
    }
   ]
  },
  {
   "line": "c13c",
   "start": 459.591,
   "end": 463.801,
   "segs": [
    {
     "text": "南宋的《大唐三藏取经诗话》里出现了猴行者",
     "q": false
    }
   ]
  },
  {
   "line": "c13c",
   "start": 463.801,
   "end": 466.837,
   "segs": [
    {
     "text": "到了明代  吴承恩写成了《西游记》",
     "q": false
    }
   ]
  },
  {
   "line": "e1",
   "start": 470.438,
   "end": 474.576,
   "segs": [
    {
     "text": "神话里  筋斗云一个跟头  十万八千里",
     "q": false
    }
   ]
  },
  {
   "line": "e2",
   "start": 475.558,
   "end": 480.418,
   "segs": [
    {
     "text": "历史上  只有一双脚  一步一步  走了五万里",
     "q": false
    }
   ]
  },
  {
   "line": "e2",
   "start": 480.418,
   "end": 481.726,
   "segs": [
    {
     "text": "走了十七年",
     "q": false
    }
   ]
  },
  {
   "line": "e3",
   "start": 482.986,
   "end": 486.826,
   "segs": [
    {
     "text": "从玄奘到唐僧  从一个人的西行",
     "q": false
    }
   ]
  },
  {
   "line": "e3",
   "start": 486.826,
   "end": 488.542,
   "segs": [
    {
     "text": "到一个民族的神话",
     "q": false
    }
   ]
  }
 ]
}